{
  "Comment": "Request Hub approval workflow. The policy engine either auto-approves (only under an admin-granted rule) or returns an ordered approval plan: the line manager, then approver groups by threshold, with admins standing in where nobody is eligible. A sequential Map walks the levels; each level pauses on a task token stored in DynamoDB, escalates to admins when its SLA is missed, and expires after a second timer. Each decision is written as a child item, and every META write is a status or level change that DynamoDB Streams turns into a domain event.",
  "StartAt": "EvaluatePolicy",
  "States": {
    "EvaluatePolicy": {
      "Type": "Task",
      "Comment": "The one Lambda call in the workflow: auto-approval rules, the module's workflow, the org hierarchy and approver groups in, a plan out.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${PolicyEngineFunctionArn}",
        "Payload": {
          "request.$": "$.detail",
          "executionId.$": "$$.Execution.Id"
        }
      },
      "ResultSelector": {
        "autoApprove.$": "$.Payload.autoApprove",
        "routable.$": "$.Payload.routable",
        "riskTier.$": "$.Payload.riskTier",
        "reasons.$": "$.Payload.reasons",
        "rulesVersion.$": "$.Payload.rulesVersion",
        "levels.$": "$.Payload.levels",
        "levelCount.$": "$.Payload.levelCount",
        "lastIndex.$": "$.Payload.lastIndex",
        "escalateToDdb.$": "$.Payload.escalateToDdb",
        "slaSeconds.$": "$.Payload.slaSeconds",
        "escalationSeconds.$": "$.Payload.escalationSeconds",
        "planJson.$": "$.Payload.planJson"
      },
      "ResultPath": "$.policy",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "MarkFailed"
        }
      ],
      "Next": "IsRoutable"
    },
    "IsRoutable": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.policy.routable",
          "BooleanEquals": false,
          "Next": "MarkUnroutable"
        },
        {
          "Variable": "$.policy.autoApprove",
          "BooleanEquals": true,
          "Next": "AutoApprove"
        }
      ],
      "Default": "ApprovalLevels"
    },
    "AutoApprove": {
      "Type": "Task",
      "Comment": "Only reached under an admin-granted auto-approval rule. The condition makes duplicate executions harmless.",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${TableName}",
        "Key": {
          "PK": {"S.$": "States.Format('REQ#{}', $.detail.requestId)"},
          "SK": {"S": "META"}
        },
        "UpdateExpression": "SET #s = :s, riskTier = :r, approverGroup = :g, policyReasons = :why, rulesVersion = :rv, decidedBy = :by, decidedAt = :now, lastUpdated = :now, executionArn = :x, GSI2PK = :g2",
        "ConditionExpression": "#s = :submitted",
        "ExpressionAttributeNames": {"#s": "status"},
        "ExpressionAttributeValues": {
          ":s": {"S": "AUTO_APPROVED"},
          ":r": {"S.$": "$.policy.riskTier"},
          ":g": {"S": "auto-approval rule"},
          ":why": {"S.$": "States.JsonToString($.policy.reasons)"},
          ":rv": {"S.$": "$.policy.rulesVersion"},
          ":by": {"S": "policy-engine"},
          ":now": {"S.$": "$$.State.EnteredTime"},
          ":x": {"S.$": "$$.Execution.Id"},
          ":g2": {"S": "STATUS#AUTO_APPROVED"},
          ":submitted": {"S": "SUBMITTED"}
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["DynamoDB.ProvisionedThroughputExceededException", "DynamoDB.ThrottlingException", "DynamoDB.InternalServerErrorException"],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException", "DynamoDb.ConditionalCheckFailedException"],
          "ResultPath": "$.error",
          "Next": "AlreadyHandled"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "MarkFailed"
        }
      ],
      "End": true
    },
    "MarkUnroutable": {
      "Type": "Task",
      "Comment": "Nobody is eligible to approve (for example the only admin raised it). Stop clearly instead of waiting forever.",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${TableName}",
        "Key": {
          "PK": {"S.$": "States.Format('REQ#{}', $.detail.requestId)"},
          "SK": {"S": "META"}
        },
        "UpdateExpression": "SET #s = :s, riskTier = :r, policyReasons = :why, rulesVersion = :rv, lastUpdated = :now, executionArn = :x, GSI2PK = :g2",
        "ConditionExpression": "#s = :submitted",
        "ExpressionAttributeNames": {"#s": "status"},
        "ExpressionAttributeValues": {
          ":s": {"S": "UNROUTABLE"},
          ":r": {"S.$": "$.policy.riskTier"},
          ":why": {"S.$": "States.JsonToString($.policy.reasons)"},
          ":rv": {"S.$": "$.policy.rulesVersion"},
          ":now": {"S.$": "$$.State.EnteredTime"},
          ":x": {"S.$": "$$.Execution.Id"},
          ":g2": {"S": "STATUS#UNROUTABLE"},
          ":submitted": {"S": "SUBMITTED"}
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException", "DynamoDb.ConditionalCheckFailedException"],
          "ResultPath": "$.error",
          "Next": "AlreadyHandled"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "MarkFailed"
        }
      ],
      "End": true
    },
    "ApprovalLevels": {
      "Type": "Map",
      "Comment": "One iteration per approval level, strictly in order. A rejection or expiry ends the whole map.",
      "ItemsPath": "$.policy.levels",
      "MaxConcurrency": 1,
      "ItemSelector": {
        "requestId.$": "$.detail.requestId",
        "level.$": "$$.Map.Item.Value",
        "policy": {
          "riskTier.$": "$.policy.riskTier",
          "reasonsJson.$": "States.JsonToString($.policy.reasons)",
          "rulesVersion.$": "$.policy.rulesVersion",
          "planJson.$": "$.policy.planJson",
          "levelCount.$": "$.policy.levelCount",
          "slaSeconds.$": "$.policy.slaSeconds",
          "escalationSeconds.$": "$.policy.escalationSeconds",
          "escalateToDdb.$": "$.policy.escalateToDdb"
        }
      },
      "ItemProcessor": {
        "ProcessorConfig": {"Mode": "INLINE"},
        "StartAt": "AwaitLevelDecision",
        "States": {
          "AwaitLevelDecision": {
            "Type": "Task",
            "Comment": "AWS SDK integration with .waitForTaskToken: names this level's approvers on the item, stores the token and pauses until SendTaskSuccess or the SLA.",
            "Resource": "arn:aws:states:::aws-sdk:dynamodb:updateItem.waitForTaskToken",
            "TimeoutSecondsPath": "$.policy.slaSeconds",
            "Parameters": {
              "TableName": "${TableName}",
              "Key": {
                "PK": {"S.$": "States.Format('REQ#{}', $.requestId)"},
                "SK": {"S": "META"}
              },
              "UpdateExpression": "SET #s = :s, currentLevel = :lvl, levelCount = :n, approverGroup = :label, approverIds = :ids, approvalToken = :t, slaSeconds = :sla, levelStartedAt = :now, lastUpdated = :now, riskTier = :r, policyReasons = :why, rulesVersion = :rv, approvalPlan = :plan, GSI2PK = :g2 REMOVE escalatedAt",
              "ConditionExpression": "#s IN (:submitted, :pending, :escalated)",
              "ExpressionAttributeNames": {"#s": "status"},
              "ExpressionAttributeValues": {
                ":s": {"S": "PENDING_APPROVAL"},
                ":lvl": {"N.$": "States.Format('{}', $.level.index)"},
                ":n": {"N.$": "States.Format('{}', $.policy.levelCount)"},
                ":label": {"S.$": "$.level.label"},
                ":ids": {"L.$": "$.level.approverIdsDdb"},
                ":t": {"S.$": "$$.Task.Token"},
                ":sla": {"N.$": "States.Format('{}', $.policy.slaSeconds)"},
                ":now": {"S.$": "$$.State.EnteredTime"},
                ":r": {"S.$": "$.policy.riskTier"},
                ":why": {"S.$": "$.policy.reasonsJson"},
                ":rv": {"S.$": "$.policy.rulesVersion"},
                ":plan": {"S.$": "$.policy.planJson"},
                ":g2": {"S": "STATUS#PENDING_APPROVAL"},
                ":submitted": {"S": "SUBMITTED"},
                ":pending": {"S": "PENDING_APPROVAL"},
                ":escalated": {"S": "ESCALATED"}
              }
            },
            "ResultPath": "$.decision",
            "Catch": [
              {"ErrorEquals": ["States.Timeout"], "ResultPath": "$.timeout", "Next": "EscalateLevel"},
              {"ErrorEquals": ["DynamoDB.ConditionalCheckFailedException", "DynamoDb.ConditionalCheckFailedException"], "ResultPath": "$.error", "Next": "LevelAlreadyHandled"},
              {"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "LevelError"}
            ],
            "Next": "LevelDecision"
          },
          "EscalateLevel": {
            "Type": "Task",
            "Comment": "SLA missed: hand this level to admins with a fresh token and a second timer.",
            "Resource": "arn:aws:states:::aws-sdk:dynamodb:updateItem.waitForTaskToken",
            "TimeoutSecondsPath": "$.policy.escalationSeconds",
            "Parameters": {
              "TableName": "${TableName}",
              "Key": {
                "PK": {"S.$": "States.Format('REQ#{}', $.requestId)"},
                "SK": {"S": "META"}
              },
              "UpdateExpression": "SET #s = :s, approverGroup = :label, approverIds = :ids, approvalToken = :t, escalatedAt = :now, lastUpdated = :now, GSI2PK = :g2",
              "ConditionExpression": "#s = :pending",
              "ExpressionAttributeNames": {"#s": "status"},
              "ExpressionAttributeValues": {
                ":s": {"S": "ESCALATED"},
                ":label": {"S.$": "States.Format('{} (escalated to admins)', $.level.label)"},
                ":ids": {"L.$": "$.policy.escalateToDdb"},
                ":t": {"S.$": "$$.Task.Token"},
                ":now": {"S.$": "$$.State.EnteredTime"},
                ":g2": {"S": "STATUS#ESCALATED"},
                ":pending": {"S": "PENDING_APPROVAL"}
              }
            },
            "ResultPath": "$.decision",
            "Catch": [
              {"ErrorEquals": ["States.Timeout"], "ResultPath": "$.timeout", "Next": "ExpireRequest"},
              {"ErrorEquals": ["DynamoDB.ConditionalCheckFailedException", "DynamoDb.ConditionalCheckFailedException"], "ResultPath": "$.error", "Next": "LevelAlreadyHandled"},
              {"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "LevelError"}
            ],
            "Next": "LevelDecision"
          },
          "LevelDecision": {
            "Type": "Choice",
            "Choices": [
              {"Variable": "$.decision.decision", "StringEquals": "APPROVED", "Next": "RecordApproval"},
              {"Variable": "$.decision.decision", "StringEquals": "REJECTED", "Next": "RecordRejection"}
            ],
            "Default": "InvalidDecision"
          },
          "RecordApproval": {
            "Type": "Task",
            "Comment": "Each decision is a child item, so it never re-triggers the request's events.",
            "Resource": "arn:aws:states:::dynamodb:putItem",
            "Parameters": {
              "TableName": "${TableName}",
              "Item": {
                "PK": {"S.$": "States.Format('REQ#{}', $.requestId)"},
                "SK": {"S.$": "States.Format('APPROVAL#{}', $.level.index)"},
                "entity": {"S": "APPROVAL"},
                "level": {"N.$": "States.Format('{}', $.level.index)"},
                "label": {"S.$": "$.level.label"},
                "decision": {"S": "APPROVED"},
                "decidedBy": {"S.$": "$.decision.decidedBy"},
                "decidedByEmail": {"S.$": "$.decision.decidedByEmail"},
                "comment": {"S.$": "$.decision.comment"},
                "at": {"S.$": "$$.State.EnteredTime"}
              }
            },
            "ResultPath": null,
            "Retry": [
              {"ErrorEquals": ["DynamoDB.ProvisionedThroughputExceededException", "DynamoDB.ThrottlingException", "DynamoDB.InternalServerErrorException"], "IntervalSeconds": 1, "MaxAttempts": 3, "BackoffRate": 2}
            ],
            "Catch": [
              {"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "LevelError"}
            ],
            "Next": "LevelApproved"
          },
          "LevelApproved": {
            "Type": "Pass",
            "Parameters": {
              "level.$": "$.level.index",
              "decidedBy.$": "$.decision.decidedBy",
              "decidedByEmail.$": "$.decision.decidedByEmail",
              "comment.$": "$.decision.comment"
            },
            "End": true
          },
          "RecordRejection": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:putItem",
            "Parameters": {
              "TableName": "${TableName}",
              "Item": {
                "PK": {"S.$": "States.Format('REQ#{}', $.requestId)"},
                "SK": {"S.$": "States.Format('APPROVAL#{}', $.level.index)"},
                "entity": {"S": "APPROVAL"},
                "level": {"N.$": "States.Format('{}', $.level.index)"},
                "label": {"S.$": "$.level.label"},
                "decision": {"S": "REJECTED"},
                "decidedBy": {"S.$": "$.decision.decidedBy"},
                "decidedByEmail": {"S.$": "$.decision.decidedByEmail"},
                "comment": {"S.$": "$.decision.comment"},
                "at": {"S.$": "$$.State.EnteredTime"}
              }
            },
            "ResultPath": null,
            "Catch": [
              {"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "LevelError"}
            ],
            "Next": "MarkRejected"
          },
          "MarkRejected": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:updateItem",
            "Parameters": {
              "TableName": "${TableName}",
              "Key": {
                "PK": {"S.$": "States.Format('REQ#{}', $.requestId)"},
                "SK": {"S": "META"}
              },
              "UpdateExpression": "SET #s = :s, decidedBy = :by, decidedByEmail = :em, decisionComment = :c, decidedAt = :now, lastUpdated = :now, GSI2PK = :g2 REMOVE approvalToken, approverIds",
              "ConditionExpression": "#s IN (:pending, :escalated)",
              "ExpressionAttributeNames": {"#s": "status"},
              "ExpressionAttributeValues": {
                ":s": {"S": "REJECTED"},
                ":by": {"S.$": "$.decision.decidedBy"},
                ":em": {"S.$": "$.decision.decidedByEmail"},
                ":c": {"S.$": "$.decision.comment"},
                ":now": {"S.$": "$$.State.EnteredTime"},
                ":g2": {"S": "STATUS#REJECTED"},
                ":pending": {"S": "PENDING_APPROVAL"},
                ":escalated": {"S": "ESCALATED"}
              }
            },
            "ResultPath": null,
            "Catch": [
              {"ErrorEquals": ["DynamoDB.ConditionalCheckFailedException", "DynamoDb.ConditionalCheckFailedException"], "ResultPath": "$.error", "Next": "LevelAlreadyHandled"},
              {"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "LevelError"}
            ],
            "Next": "RejectedStop"
          },
          "ExpireRequest": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:updateItem",
            "Parameters": {
              "TableName": "${TableName}",
              "Key": {
                "PK": {"S.$": "States.Format('REQ#{}', $.requestId)"},
                "SK": {"S": "META"}
              },
              "UpdateExpression": "SET #s = :s, lastUpdated = :now, GSI2PK = :g2 REMOVE approvalToken, approverIds",
              "ConditionExpression": "#s = :escalated",
              "ExpressionAttributeNames": {"#s": "status"},
              "ExpressionAttributeValues": {
                ":s": {"S": "EXPIRED"},
                ":now": {"S.$": "$$.State.EnteredTime"},
                ":g2": {"S": "STATUS#EXPIRED"},
                ":escalated": {"S": "ESCALATED"}
              }
            },
            "ResultPath": null,
            "Catch": [
              {"ErrorEquals": ["DynamoDB.ConditionalCheckFailedException", "DynamoDb.ConditionalCheckFailedException"], "ResultPath": "$.error", "Next": "LevelAlreadyHandled"},
              {"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "LevelError"}
            ],
            "Next": "ExpiredStop"
          },
          "RejectedStop": {"Type": "Fail", "Error": "Rejected", "Cause": "An approver rejected the request; later levels are skipped."},
          "ExpiredStop": {"Type": "Fail", "Error": "Expired", "Cause": "Nobody decided before the escalation timer ran out."},
          "LevelAlreadyHandled": {"Type": "Fail", "Error": "AlreadyHandled", "Cause": "Another execution or a newer state already moved this request on."},
          "InvalidDecision": {"Type": "Fail", "Error": "InvalidDecision", "Cause": "The callback did not contain APPROVED or REJECTED."},
          "LevelError": {"Type": "Fail", "ErrorPath": "$.error.Error", "CausePath": "$.error.Cause"}
        }
      },
      "ResultPath": "$.levelResults",
      "Catch": [
        {"ErrorEquals": ["Rejected", "Expired", "AlreadyHandled"], "ResultPath": "$.outcome", "Next": "Finished"},
        {"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "MarkFailed"}
      ],
      "Next": "PickFinalDecision"
    },
    "PickFinalDecision": {
      "Type": "Pass",
      "Comment": "The last level's decision is the one that completes the approval.",
      "Parameters": {
        "decision.$": "States.ArrayGetItem($.levelResults, $.policy.lastIndex)"
      },
      "ResultPath": "$.final",
      "Next": "MarkApproved"
    },
    "MarkApproved": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${TableName}",
        "Key": {
          "PK": {"S.$": "States.Format('REQ#{}', $.detail.requestId)"},
          "SK": {"S": "META"}
        },
        "UpdateExpression": "SET #s = :s, decidedBy = :by, decidedByEmail = :em, decisionComment = :c, decidedAt = :now, lastUpdated = :now, executionArn = :x, GSI2PK = :g2 REMOVE approvalToken, approverIds",
        "ConditionExpression": "#s IN (:pending, :escalated)",
        "ExpressionAttributeNames": {"#s": "status"},
        "ExpressionAttributeValues": {
          ":s": {"S": "APPROVED"},
          ":by": {"S.$": "$.final.decision.decidedBy"},
          ":em": {"S.$": "$.final.decision.decidedByEmail"},
          ":c": {"S.$": "$.final.decision.comment"},
          ":now": {"S.$": "$$.State.EnteredTime"},
          ":x": {"S.$": "$$.Execution.Id"},
          ":g2": {"S": "STATUS#APPROVED"},
          ":pending": {"S": "PENDING_APPROVAL"},
          ":escalated": {"S": "ESCALATED"}
        }
      },
      "ResultPath": null,
      "Catch": [
        {"ErrorEquals": ["DynamoDB.ConditionalCheckFailedException", "DynamoDb.ConditionalCheckFailedException"], "ResultPath": "$.error", "Next": "AlreadyHandled"},
        {"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "MarkFailed"}
      ],
      "End": true
    },
    "MarkFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${TableName}",
        "Key": {
          "PK": {"S.$": "States.Format('REQ#{}', $.detail.requestId)"},
          "SK": {"S": "META"}
        },
        "UpdateExpression": "SET #s = :s, failureCause = :cause, lastUpdated = :now, executionArn = :x, GSI2PK = :g2 REMOVE approvalToken, approverIds",
        "ExpressionAttributeNames": {"#s": "status"},
        "ExpressionAttributeValues": {
          ":s": {"S": "FAILED"},
          ":cause": {"S.$": "States.JsonToString($.error)"},
          ":now": {"S.$": "$$.State.EnteredTime"},
          ":x": {"S.$": "$$.Execution.Id"},
          ":g2": {"S": "STATUS#FAILED"}
        }
      },
      "ResultPath": null,
      "Catch": [
        {"ErrorEquals": ["States.ALL"], "ResultPath": "$.markFailedError", "Next": "WorkflowFailed"}
      ],
      "Next": "WorkflowFailed"
    },
    "WorkflowFailed": {
      "Type": "Fail",
      "Error": "RequestWorkflowFailed",
      "Cause": "See the failureCause attribute on the request item and the execution history."
    },
    "Finished": {
      "Type": "Succeed",
      "Comment": "Rejected, expired or already handled: the request item already says so."
    },
    "AlreadyHandled": {
      "Type": "Succeed",
      "Comment": "Another execution or a newer state already moved this request on (for example a duplicate event delivery), so this run stops without changing anything."
    }
  }
}
